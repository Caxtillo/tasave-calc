{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/rates.json", "destination": "/rates.json" },
    { "source": "/sw.js", "destination": "/sw.js" },
    { "source": "/manifest.json", "destination": "/manifest.json" },
    { "source": "/abeja.png", "destination": "/abeja.png" },
    { "source": "/(.*)", "destination": "/" }
  ]
}
